{
  // Static site served from the repo root, plus a small backend (worker/index.js) for /api/*
  "name": "visualartworld",
  "compatibility_date": "2025-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // one SQLite-backed Durable Object holds edited content, uploaded photos and contact messages
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "SiteStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteStore"] }],
  "observability": { "enabled": true }
}
